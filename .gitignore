# Visual Studio local settings
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
*.sdf
*.opensdf
ipch/

# Visual Studio build directories (at any project depth)
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Bb]in/
[Oo]bj/

# C/C++ build intermediates and executables
*.obj
*.o
*.pch
*.pdb
*.idb
*.ipdb
*.iobj
*.ilk
*.tlog
*.lastbuildstate
*.log
*.exe
*.exe.manifest
*.res
*.exp
*.aps
*.ncb
*.opendb
*.cache

# OpenGL OBJ model assets are source assets, not compiler intermediates.
!**/[Aa]ssets/**/*.obj
!**/[Mm]odels/**/*.obj

# CMake-generated files
/build/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Editor and operating system temporary files
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# Local environment values
.env
.env.*
!.env.example
!.env.sample

# Keep source, shaders, textures, models, and third-party headers/libs/DLLs.
# Put vendored libraries in a dedicated folder such as third_party/.
!/third_party/**
