root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,sln,slnx,vcxproj,filters,props,targets,bat,cmd}]
end_of_line = crlf

[*.{json,yml,yaml,xml,vcxproj,filters,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
